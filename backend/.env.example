# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lesa-lego

# Telegram Bot (https://t.me/BotFather dan oling)
BOT_TOKEN=your_bot_token_here

# Telegram WebApp URL (frontend URL)
WEBAPP_URL=https://your-frontend-url.vercel.app

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Biznes vaqt mintaqasi — arenda kunlari, hisobot kunlari va cron shunga tayanadi
APP_TZ=Asia/Tashkent
